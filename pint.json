{
    "preset": "laravel",
    "exclude": [
        "tests/personal",
        "resources",
        "config"
    ],
    "rules": {
        "binary_operator_spaces": {
            "operators": {
                "=>": "align",
                "=": "align"
            }
        },
        "concat_space": {
            "spacing": "one"
        },
        "class_attributes_separation": {
            "elements": {
                "property": "none"
            }
        }
    }
}
